# PULSE INVESTMENT PLATFORM - ENVIRONMENT VARIABLES

# ============================================================
# SUPABASE CONFIGURATION (Required - Public)
# ============================================================
# Get these from: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================
# SUPABASE CONFIGURATION (Required - Private/Server Only)
# ============================================================
# KEEP THESE SECRET - Never expose in frontend!

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================
# DATABASE CONFIGURATION (Supabase Postgres)
# ============================================================
# Auto-filled by Supabase, or get from Project Settings → Database

POSTGRES_URL=postgresql://postgres:[password]@[host]:5432/postgres
POSTGRES_PRISMA_URL=postgresql://postgres:[password]@[host]:5432/postgres?schema=public&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgresql://postgres:[password]@[host]:5432/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DATABASE=postgres
POSTGRES_HOST=your-project-id.supabase.co

# ============================================================
# ADMIN AUTHENTICATION (Pulse Admin Portal Only)
# ============================================================
# NOT Supabase - these are for /admin/login portal
# Keep these VERY secure. Generate with: openssl rand -base64 32

PULSE_ADMIN_EMAIL=admin@pulse-invest.app
PULSE_ADMIN_PASSWORD=your_secure_admin_password_32_chars_minimum

# ============================================================
# ADMIN API KEY (For Backend Integrations)
# ============================================================
# Used for server-side admin operations
# Generate with: openssl rand -base64 32

ADMIN_API_KEY=your_admin_api_key_base64_here

# ============================================================
# AI & INTEGRATIONS (Optional)
# ============================================================
# For AI SDK, image generation, or other services

AI_GATEWAY_API_KEY=your_ai_gateway_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# EMAIL SERVICE (Optional - if using external email)
# ============================================================
# If using Resend, SendGrid, Mailgun, etc.

EMAIL_SERVICE_KEY=your_email_service_key_here
SENDGRID_API_KEY=your_sendgrid_key_here

# ============================================================
# PAYMENT GATEWAYS (Optional)
# ============================================================
# For deposit/withdrawal processing

NOWPAYMENTS_API_KEY=your_nowpayments_key_here
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret

# ============================================================
# BLOB STORAGE (Optional - Vercel Blob)
# ============================================================
# For KYC photo ID storage, user uploads

BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# ============================================================
# DEVELOPMENT (Local Only)
# ============================================================
# Use these for localhost development

NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# ============================================================
# ANALYTICS & MONITORING (Optional)
# ============================================================

NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_vercel_analytics_id
SENTRY_DSN=your_sentry_dsn_here

# ============================================================
# APP CONFIGURATION
# ============================================================

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://pulse-invest.vercel.app
